{
  "env": {
    "CLAUDE_CODE_USE_POWERSHELL_TOOL": "1"
  },
  "defaultShell": "powershell",
  "permissions": {
    "allow": [
      "PowerShell(uv run pytest *)",
      "PowerShell(uv run ruff *)",
      "PowerShell(git status)",
      "PowerShell(git diff *)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(git status)",
      "Bash(git diff *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Read(./secrets/**)",
      "PowerShell(git push --force)",
      "PowerShell(git push --force *)",
      "PowerShell(git *push*--force*)",
      "PowerShell(git push -f)",
      "PowerShell(git push -f *)",
      "PowerShell(git *push* -f)",
      "PowerShell(git *push* -f *)",
      "PowerShell(git *push* +*)",
      "PowerShell(Remove-Item -r*)",
      "PowerShell(Remove-Item * -r*)",
      "PowerShell(Remove-Item -R*)",
      "PowerShell(Remove-Item * -R*)",
      "PowerShell(remove-item -r*)",
      "PowerShell(remove-item * -r*)",
      "PowerShell(remove-item -R*)",
      "PowerShell(remove-item * -R*)",
      "PowerShell(rm -r*)",
      "PowerShell(rm * -r*)",
      "PowerShell(rm -R*)",
      "PowerShell(rm * -R*)",
      "PowerShell(del -r*)",
      "PowerShell(del * -r*)",
      "PowerShell(del -R*)",
      "PowerShell(del * -R*)",
      "PowerShell(ri -r*)",
      "PowerShell(ri * -r*)",
      "PowerShell(ri -R*)",
      "PowerShell(ri * -R*)",
      "PowerShell(rd -r*)",
      "PowerShell(rd * -r*)",
      "PowerShell(rd -R*)",
      "PowerShell(rd * -R*)",
      "PowerShell(rmdir -r*)",
      "PowerShell(rmdir * -r*)",
      "PowerShell(rmdir -R*)",
      "PowerShell(rmdir * -R*)",
      "PowerShell(erase -r*)",
      "PowerShell(erase * -r*)",
      "PowerShell(erase -R*)",
      "PowerShell(erase * -R*)",
      "Bash(git push --force)",
      "Bash(git push --force *)",
      "Bash(git *push*--force*)",
      "Bash(git push -f)",
      "Bash(git push -f *)",
      "Bash(git *push* -f)",
      "Bash(git *push* -f *)",
      "Bash(git *push* +*)",
      "Bash(rm -r*)",
      "Bash(rm * -r*)",
      "Bash(rm -R*)",
      "Bash(rm * -R*)",
      "Bash(rm -fr*)",
      "Bash(rm * -fr*)",
      "Bash(rm -fR*)",
      "Bash(rm * -fR*)",
      "Bash(rm --recursive*)",
      "Bash(rm * --recursive*)"
    ]
  }
}
